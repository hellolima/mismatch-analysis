% título de seção: Tomorrow em caixa alta, com a barra vermelha dos logos DCC/UFMG
\newcommand{\secao}[1]{%
  {\tomorrow\fontsize{37}{40}\selectfont\color{preto}#1\par}%
  \vspace{0.08cm}{\color{vermelho}\rule{3.8cm}{0.28cm}}\par\vspace{0.18cm}}
\newcommand{\rotulo}[1]{{\tomorrow\fontsize{23}{28}\selectfont\color{vermelho}#1}}

\setlist[itemize]{label={\textcolor{vermelho}{\rule[0.13em]{0.42em}{0.42em}}},
  leftmargin=1.15em, labelsep=0.55em, itemsep=0.32em, topsep=0.25em, parsep=0pt, partopsep=0pt}

\newtcolorbox{destaque}[1][]{colback=cinzaclaro, colframe=vermelho, boxrule=0pt,
  leftrule=0.45cm, arc=0pt, outer arc=0pt, left=0.9cm, right=0.9cm, top=0.7cm, bottom=0.7cm,
  boxsep=0pt, before skip=0.2cm, after skip=0cm, halign=justify, #1}

% ------------------------------------------------------------------ gráficos
\pgfplotsset{
  /pgf/number format/use comma,
  every axis/.append style={font=\fontsize{24}{28}\selectfont, line width=1.6pt,
    tick style={line width=1.4pt, color=cinzaescuro}, axis line style={cinzaescuro}},
  every tick label/.append style={font=\fontsize{24}{28}\selectfont},
  legend style={font=\fontsize{23}{28}\selectfont, draw=none, fill=none},
}

% linha de eixo de conteúdo: \eixo{prevalência}{nome}{o que leitores marcam / o que a sinopse diz}
\newcommand{\eixo}[3]{%
  \noindent\makebox[3.4cm][l]{\fontsize{31}{34}\selectfont\color{vermelho}#1}%
  \parbox[t]{\dimexpr\linewidth-3.4cm\relax}{\raggedright\fontsize{24.5}{29}\selectfont
    \leavevmode{\semib\color{preto}#2:} #3}\par\vspace{0.4cm}}
% obstáculo: \obstaculo{número}{título}{texto}
\newcommand{\obstaculo}[3]{%
  \vspace{0.15cm}{\rotulo{#1\enspace#2}}\par\vspace{0.1cm}
  {\fontsize{25}{31}\selectfont #3\par}
  \vspace{0.2cm}{\color{cinzamedio!60}\rule{\linewidth}{1.2pt}}\par\vspace{0.1cm}}
% linha do rótulo: \nivel{nome}{n}{significado}
\newcommand{\nivel}[3]{%
  \noindent\makebox[8.6cm][l]{\rotulo{#1}}%
  \makebox[2.6cm][r]{\semib #2}\enspace
  \parbox[t]{\dimexpr\linewidth-11.6cm\relax}{\raggedright\pequeno\color{cinzaescuro}#3}\par\vspace{0.25cm}}
% fontes das caixas do diagrama do pipeline
\newcommand{\cxnome}{\tomorrow\fontsize{21}{24}\selectfont\color{vermelho}}
\newcommand{\cxdet}{\fontsize{18.5}{22}\selectfont\color{preto}}

% ------------------------------------------------------------------ colunas
\newcommand{\Ytopo}{15.2}         % topo das colunas (cm, a partir do topo da página)
\newcommand{\Ybase}{78.7}         % base das colunas (o QR code do rodapé começa em 79,4 cm)
\newcommand{\LarguraColuna}{26.2}  % colunas em x = 3 e x = 30,8
\newenvironment{coluna}[1]{% #1 = x da coluna, em cm
  \begin{textblock}{\LarguraColuna}(#1,\Ytopo)%
  \begin{minipage}[t][\dimexpr\Ybase cm-\Ytopo cm\relax][s]{\LarguraColuna cm}%
  \corpo\setlength{\emergencystretch}{1.5em}}%
  {\par\end{minipage}\end{textblock}}
\newcommand{\proxima}{\par\vfill}  % separa as seções de uma coluna

% bloco de conteúdo: \begin{bloco}{largura}{x}{y} ... \end{bloco}  (em cm, a partir do canto
% superior esquerdo da página)
\newenvironment{bloco}[3]{\begin{textblock}{#1}(#2,#3)\corpo\setlength{\emergencystretch}{1.5em}}{\end{textblock}}

% grade auxiliar de 1 cm (true = desenha)
\newif\ifgrade \gradefalse
\newcommand{\grade}{\ifgrade\begin{textblock}{60}(0,0)\begin{tikzpicture}[x=1cm,y=1cm]
  \draw[cyan!40,line width=0.4pt] (0,0) grid (60,-90);
  \foreach \i in {0,5,...,60} \node[cyan,anchor=north west,font=\fontsize{14}{14}\selectfont] at (\i,0) {\i};
  \foreach \j in {0,5,...,90} \node[cyan,anchor=north west,font=\fontsize{14}{14}\selectfont] at (0,-\j) {\j};
  \end{tikzpicture}\end{textblock}\fi}

