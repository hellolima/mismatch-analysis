\IfFontExistsTF{TitilliumWeb-Regular.ttf}{%
  \setmainfont{TitilliumWeb}[Extension=.ttf, UprightFont=*-Regular, BoldFont=*-Bold,
    ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
  \newfontfamily\semib{TitilliumWeb-SemiBold.ttf}%
}{\IfFontExistsTF{FiraSans-Regular.otf}{%
  \setmainfont{FiraSans}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold,
    ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
  \newfontfamily\semib{FiraSans-SemiBold.otf}%
}{\setmainfont{Carlito}\newfontfamily\semib{Carlito}[UprightFont=* Bold]}}
\IfFontExistsTF{Tomorrow-Bold.ttf}{%
  \newfontfamily\tomorrow{Tomorrow-Bold.ttf}%
}{\IfFontExistsTF{Montserrat-ExtraBold.otf}{\newfontfamily\tomorrow{Montserrat-ExtraBold.otf}}%
